# IBeam environment for ibkr-cli gateway mode (paper-first scaffold).
#
#   cp env.list.example env.list
#   chmod 600 env.list
#   # then fill in IBEAM_ACCOUNT and IBEAM_PASSWORD below
#
# env.list holds your IBKR password. NEVER commit it (it is
# git-ignored), keep it mode 0600, and prefer a dedicated or paper
# username: IBKR allows ONE brokerage session per username across all
# platforms, so this stack's session competes with TWS / mobile / web
# logins under the same username (docs/SPEC.md §3).

IBEAM_ACCOUNT=your_ibkr_username
IBEAM_PASSWORD=

# Paper-first: IBeam logs into the paper account. Trading live money
# requires deliberately flipping this to false — do that on purpose,
# never by accident, and never by copying someone else's env file.
IBEAM_USE_PAPER_ACCOUNT=true

# --- Two-factor authentication --------------------------------------
# Recommended for agents: TOTP. IBeam's PyotpHandler answers the 2FA
# challenge from the authenticator seed, fully unattended.
# IBEAM_TWO_FA_HANDLER=PyotpHandler
# IBEAM_PYOTP_SECRET=your_totp_seed
#
# Alternative: IBeam's ExternalRequestHandler asks an HTTP endpoint
# you control for the code (e.g. a phone webhook / code relay).
# IBEAM_TWO_FA_HANDLER=ExternalRequestHandler
# IBEAM_EXTERNAL_REQUEST_URL=https://example.invalid/2fa-code
# (see IBeam's docs for _METHOD/_PARAMS/_DATA/_HEADERS/_TIMEOUT)

# --- Login safety ----------------------------------------------------
# IBeam gives up after this many failed logins. compose.yaml's
# restart: "no" exists so a wrong password cannot loop past it.
# IBEAM_MAX_FAILED_AUTH=5
